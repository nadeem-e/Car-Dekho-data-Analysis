USE nadeemdb;

SELECT * FROM `car dekho`;
'''1) checking wheather there is NULL or empty rows , and removing it.'''
SELECT
    COUNT(*) AS total_rows,
    
    SUM(CASE
        WHEN name IS NULL OR TRIM(name) = ''
        THEN 1 
        ELSE 0
    END) AS name_missing,

    SUM(CASE
        WHEN year IS NULL
        THEN 1 
        ELSE 0
    END) AS year_missing,

    SUM(CASE
        WHEN selling_price IS NULL
        THEN 1 ELSE 0
    END) AS price_missing,

    SUM(CASE
        WHEN km_driven IS NULL
        THEN 1 
        ELSE 0
    END) AS km_missing,

    SUM(CASE
        WHEN fuel IS NULL OR TRIM(fuel) = ''
        THEN 1 
        ELSE 0
    END) AS fuel_missing,

    SUM(CASE
        WHEN seller_type IS NULL OR TRIM(seller_type) = ''
        THEN 1 
        ELSE 0
    END) AS seller_missing,

    SUM(CASE
        WHEN transmission IS NULL OR TRIM(transmission) = ''
        THEN 1 
        ELSE 0
    END) AS transmission_missing,

    SUM(CASE
        WHEN owner IS NULL OR TRIM(owner) = ''
        THEN 1 
        ELSE 0
    END) AS owner_missing,

    SUM(CASE
        WHEN mileage IS NULL OR TRIM(mileage) = ''
        THEN 1 ELSE 0
    END) AS mileage_missing,

    SUM(CASE
        WHEN engine IS NULL OR TRIM(engine) = ''
        THEN 1 ELSE 0
    END) AS engine_missing,

    SUM(CASE
        WHEN max_power IS NULL OR TRIM(max_power) = ''
        THEN 1 
        ELSE 0
    END) AS power_missing,

    SUM(CASE
        WHEN torque IS NULL OR TRIM(torque) = ''
        THEN 1 
        ELSE 0
    END) AS torque_missing,

    SUM(CASE
        WHEN seats IS NULL
        THEN 1 
        ELSE 0
    END) AS seats_missing
FROM `car dekho`;

