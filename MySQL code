-- Univariate --

-- 1. How many cars are there for each fuel type? --
SELECT
    fuel,
    COUNT(*) AS number_of_cars
FROM car_dekho
GROUP BY fuel
ORDER BY number_of_cars DESC;

-- 2. What is the distribution of selling prices? --
SELECT
    CASE
        WHEN selling_price < 100000 THEN '0 - 99,999'
        WHEN selling_price < 200000 THEN '100,000 - 199,999'
        WHEN selling_price < 300000 THEN '200,000 - 299,999'
        WHEN selling_price < 400000 THEN '300,000 - 399,999'
        WHEN selling_price < 500000 THEN '400,000 - 499,999'
        WHEN selling_price < 600000 THEN '500,000 - 599,999'
        WHEN selling_price < 700000 THEN '600,000 - 699,999'
        WHEN selling_price < 800000 THEN '700,000 - 799,999'
        WHEN selling_price < 900000 THEN '800,000 - 899,999'
        ELSE '900,000+'
    END AS price_range,
    COUNT(*) AS number_of_cars
FROM car_dekho
GROUP BY price_range
ORDER BY MIN(selling_price);

