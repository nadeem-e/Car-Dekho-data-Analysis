'''4) Feature engineering- process of creating, changing, or selecting useful features (columns) from raw data'''
'''so that we are creating another coloumns in our table ‘car_dekho_extra'''
ALTER TABLE car_dekho_extra
ADD COLUMN year INT;

-- Then copy the year using id: --
UPDATE car_dekho_extra e
JOIN car_dekho c
    ON e.id = c.id
SET e.year = c.year;


-- Adding new coloumns --
ALTER TABLE car_dekho_extra
ADD COLUMN car_age INT,
ADD COLUMN engine_category VARCHAR(20),
ADD COLUMN power_category VARCHAR(20),
ADD COLUMN torque_category VARCHAR(20),
ADD COLUMN mileage_category VARCHAR(20);

-- add data to this newly created coloumns --
-- Car Age --
UPDATE car_dekho_extra
SET car_age = 2026 - year
WHERE id > 0;

-- adding engine_category --
UPDATE car_dekho_extra
SET engine_category =
    CASE
        WHEN engine IS NULL THEN NULL
        WHEN engine < 1200 THEN 'Small'
        WHEN engine < 1600 THEN 'Medium'
        WHEN engine < 2000 THEN 'Large'
        ELSE 'Very Large'
    END
WHERE id > 0;
    
-- adding power_category --
UPDATE car_dekho_extra
SET power_category =
    CASE
        WHEN max_power IS NULL THEN NULL
        WHEN max_power < 75 THEN 'Low'
        WHEN max_power < 120 THEN 'Medium'
        WHEN max_power < 180 THEN 'High'
        ELSE 'Very High'
    END
WHERE id > 0;

-- adding torque_category --
UPDATE car_dekho_extra
SET torque_category =
    CASE
        WHEN torque IS NULL THEN NULL
        WHEN torque < 150 THEN 'Low'
        WHEN torque < 250 THEN 'Medium'
        WHEN torque < 400 THEN 'High'
        ELSE 'Very High'
    END
WHERE id > 0;

-- adding mileage_category --
UPDATE car_dekho_extra
SET mileage_category =
    CASE
        WHEN mileage IS NULL THEN NULL
        WHEN mileage < 15 THEN 'Low'
        WHEN mileage < 20 THEN 'Medium'
        ELSE 'High'
    END
WHERE id > 0;

select * from car_dekho_extra;


