'''3) Now we need to check wheather my datatypes are in proper format '''
DESCRIBE car_dekho;
'''from this mileage,engine,max_power and torque contains DECIMAL+UNIT 
we cannot simply remove the units bcs for eg: in milage session we have kmpl and kg/kg so when we 
deleting whole unit,it will be a problem. 
so we are creating a new table containing this 4 fields 
and for connecting those tables we need to create an ID coloumn to our main dataset'''

ALTER TABLE car_dekho
ADD COLUMN id INT AUTO_INCREMENT PRIMARY KEY FIRST;

CREATE TABLE car_dekho_extra (
    id INT PRIMARY KEY,
    mileage DECIMAL(10,2),
    mileage_unit VARCHAR(10),
    engine DECIMAL(10,2),
    engine_unit VARCHAR(10),
    max_power DECIMAL(10,2),
    power_unit VARCHAR(10),
    torque DECIMAL(10,2),
    torque_unit VARCHAR(10),
    FOREIGN KEY (id) REFERENCES car_dekho(id)
);


'''to get the data from car_dekho to car_dekho_extra; '''
'''mileage'''
SELECT
    id,
    mileage,
    CAST(SUBSTRING_INDEX(mileage, ' ', 1) AS DECIMAL(10,2)) AS mileage_value,
    SUBSTRING_INDEX(mileage, ' ', -1) AS mileage_unit
FROM car_dekho;
'''engine'''
SELECT
    id,
    engine,
    CAST(REPLACE(engine, ' CC', '') AS DECIMAL(10,2)) AS engine_value,
    'CC' AS engine_unit
FROM car_dekho;
'''max power'''
SELECT
    id,
    max_power,
    CAST(REPLACE(max_power, ' bhp', '') AS DECIMAL(10,2)) AS power_value,
    'bhp' AS power_unit
FROM car_dekho;
'''torque'''
SELECT
    id,
    torque,
    CAST(
        SUBSTRING_INDEX(
            REPLACE(torque, 'Nm', ''),
            '@',
            1
        ) AS DECIMAL(10,2)
    ) AS torque_value,
    'Nm' AS torque_unit
FROM car_dekho;

INSERT INTO car_dekho_extra
(
    id,
    mileage,
    mileage_unit,
    engine,
    engine_unit,
    max_power,
    power_unit,
    torque,
    torque_unit
)
SELECT
    id,
    -- Mileage
    CAST(SUBSTRING_INDEX(mileage, ' ', 1) AS DECIMAL(10,2)),
    SUBSTRING_INDEX(mileage, ' ', -1),
    -- Engine
    CAST(REPLACE(engine, ' CC', '') AS DECIMAL(10,2)),
    'CC',
    -- Max Power
    CAST(REPLACE(max_power, ' bhp', '') AS DECIMAL(10,2)),
    'bhp',
    -- Torque
    CAST(
        SUBSTRING_INDEX(
            REPLACE(torque, 'Nm', ''),
            '@',
            1
        ) AS DECIMAL(10,2)
    ),
    'Nm'
FROM car_dekho;
