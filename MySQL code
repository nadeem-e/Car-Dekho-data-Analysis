-- Bivariete --

-- 1. Does kilometers driven affect selling price? --
SELECT
    km_driven,
    AVG(selling_price) AS average_selling_price
FROM car_dekho
GROUP BY km_driven
ORDER BY km_driven;

-- 2. Does car age affect selling price? --
SELECT
    e.car_age,
    AVG(c.selling_price) AS average_selling_price
FROM car_dekho_extra e
JOIN car_dekho c
    ON e.id = c.id
GROUP BY e.car_age
ORDER BY e.car_age ASC;

-- 3.Does engine affect avg selling price? --
SELECT
    e.engine,
    AVG(c.selling_price)
FROM car_dekho_extra e
JOIN car_dekho c
    ON e.id = c.id
GROUP BY engine
ORDER BY engine ASC;

