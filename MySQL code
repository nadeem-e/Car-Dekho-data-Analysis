    km_driven,
    fuel,
    seller_type,
    transmission,
    owner,
    mileage,
    engine,
    max_power,
    torque,
    seats
HAVING COUNT(*) > 1;


'''To remove duplicate data , we can use distict'''
CREATE TABLE `car dekho_clean` AS
SELECT DISTINCT *
FROM `car dekho`;

SELECT COUNT(*) AS original_rows
FROM car_dekho;

SELECT COUNT(*) AS cleaned_rows
FROM `car dekho_clean`;

DROP TABLE `car dekho`;
RENAME TABLE `car dekho_clean` TO `car dekho`;

